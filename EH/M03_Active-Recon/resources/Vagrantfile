# Vagrantfile - Bab 3: Kali Attacker dengan tools active recon & enumeration
#
# VM ini HANYA untuk attacker (Kali). Target Metasploitable2 disiapkan terpisah,
# lihat README.md untuk dua opsi: VirtualBox (import_metasploitable2.sh) atau
# Docker (docker-compose.yml).
#
# Cara pakai:
#   vagrant up
#   vagrant ssh

Vagrant.configure("2") do |config|
  config.vm.box = "kalilinux/rolling"
  config.vm.hostname = "kali-attacker-bab3"

  # Host-only network - samakan segmen dengan network target Metasploitable2 (lihat README)
  config.vm.network "private_network", ip: "192.168.56.12"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "Bab03-Kali-ActiveRecon"
    vb.memory = "4096"
    vb.cpus = 2
  end

  config.vm.provision "shell", path: "provision.sh"
end
