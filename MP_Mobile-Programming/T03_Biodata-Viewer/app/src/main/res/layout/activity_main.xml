<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DATA DIRI"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Silakan masukkan data diri Anda"
            android:textSize="15sp"
            android:textColor="#6B7280"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp" />

        <!-- Nama -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#374151"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtNama"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Masukkan nama lengkap"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#FFFFFF"
            android:inputType="textPersonName"
            android:layout_marginBottom="18dp" />

        <!-- NRP -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NRP"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#374151"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtNrp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Masukkan NRP"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#FFFFFF"
            android:inputType="number"
            android:layout_marginBottom="18dp" />

        <!-- Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#374151"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Masukkan alamat email"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#FFFFFF"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="18dp" />

        <!-- Nomor Telepon -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nomor Telepon"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#374151"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtTelepon"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Masukkan nomor telepon"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#FFFFFF"
            android:inputType="phone"
            android:layout_marginBottom="28dp" />

        <!-- Button -->
        <Button
            android:id="@+id/btnKirim"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="TAMPILKAN DATA"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB" />

    </LinearLayout>

</ScrollView>